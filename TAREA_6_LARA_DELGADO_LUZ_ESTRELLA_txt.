# 1. Lista que funciona como conjunto

def agregar_elemento(lista, elemento):
    if elemento not in lista:
        lista.append(elemento)


# Funcion para agregar o modificar valores usando llaves
def agregar_valor(llaves, valores, llave, valor):
    if llave in llaves:
        posicion = llaves.index(llave)
        valores[posicion] = valor
    else:
        llaves.append(llave)
        valores.append(valor)


conjunto = [1, 2, 3, 4]

agregar_elemento(conjunto, 5)
agregar_elemento(conjunto, 3)

print("Lista como conjunto:", conjunto)


