# 3. Convertir nucleotidos en proteina

codigo_genetico = {
    "TTT": "F", "TTC": "F", "TTA": "L", "TTG": "L",
    "TCT": "S", "TCC": "S", "TCA": "S", "TCG": "S",
    "TAT": "Y", "TAC": "Y", "TAA": "*", "TAG": "*",
    "TGT": "C", "TGC": "C", "TGA": "*", "TGG": "W",

    "CTT": "L", "CTC": "L", "CTA": "L", "CTG": "L",
    "CCT": "P", "CCC": "P", "CCA": "P", "CCG": "P",
    "CAT": "H", "CAC": "H", "CAA": "Q", "CAG": "Q",
    "CGT": "R", "CGC": "R", "CGA": "R", "CGG": "R",

    "ATT": "I", "ATC": "I", "ATA": "I", "ATG": "M",
    "ACT": "T", "ACC": "T", "ACA": "T", "ACG": "T",
    "AAT": "N", "AAC": "N", "AAA": "K", "AAG": "K",
    "AGT": "S", "AGC": "S", "AGA": "R", "AGG": "R",

    "GTT": "V", "GTC": "V", "GTA": "V", "GTG": "V",
    "GCT": "A", "GCC": "A", "GCA": "A", "GCG": "A",
    "GAT": "D", "GAC": "D", "GAA": "E", "GAG": "E",
    "GGT": "G", "GGC": "G", "GGA": "G", "GGG": "G"
}


def traducir_proteina(secuencia):
    secuencia = secuencia.upper()

    if len(secuencia) % 3 != 0:
        raise ValueError("La secuencia debe tener una longitud multiplo de 3")

    proteina = ""

    for i in range(0, len(secuencia), 3):
        codon = secuencia[i:i+3]

        if codon not in codigo_genetico:
            raise ValueError("La secuencia contiene nucleotidos no validos")

        proteina += codigo_genetico[codon]

    return proteina


secuencia = "ATGGCTTTTTAA"

resultado = traducir_proteina(secuencia)

print("Secuencia de nucleotidos:", secuencia)
print("Proteina:", resultado)
