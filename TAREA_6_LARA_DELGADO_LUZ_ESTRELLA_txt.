llaves = ["uno", "dos", "tercero"]
valores = [1, 2, 3]


def buscar_valor(llaves, valores, llave):
    if llave in llaves:
        posicion = llaves.index(llave)
        print(f"La llave {llave}, tiene valor {valores[posicion]}")
    else:
        print("La llave no existe")


