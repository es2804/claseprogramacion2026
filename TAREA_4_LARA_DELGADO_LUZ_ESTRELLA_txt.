R=  def GCcontent(secuencia):
    secuencia = secuencia.upper()

    if len(secuencia) == 0:
        return 0

    cantidad = secuencia.count("G") + secuencia.count("C")

    return cantidad / len(secuencia)

assert(GCcontent("ATGC") == .5)
assert(GCcontent("") == 0)
assert(GCcontent("AAAA") == 0)
assert(GCcontent("ATgc") == .5)
assert(GCcontent("GGCC") == 1)

